# Tu clave de OpenAI. Cópiala aquí y NO la subas al repo.
OPENAI_API_KEY=
# Modelo de OpenAI que usará tu código. Elige el que quieras y explica por qué en el README.
MODELO=

# Opcional: trazas de cada ejecución en LangSmith. Sin estas variables el sistema funciona igual.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=kontaktu-post-call
# Solo si la organización de LangSmith está en la región EU (eu.smith.langchain.com):
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
